<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="RenownRewardTracker" parent="UIParent" movable="true" resizable="true" registerForDrag="LeftButton" enableMouse="true" mixin="RRTMainMixin">
        <Size x="RRT_WINDOW_MIN_WIDTH" y="RRT_WINDOW_MIN_HEIGHT"/>
        <ResizeBounds>
            <minResize x="RRT_WINDOW_MIN_WIDTH" y="RRT_WINDOW_MIN_HEIGHT"/>
            <maxResize x="RRT_WINDOW_MAX_WIDTH" y="RRT_WINDOW_MAX_HEIGHT"/>
        </ResizeBounds>
        <Anchors>
            <Anchor point="TOP" y="-50"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.8"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Title" inherits="GameFontHighlightMedium" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-10"/>
                        <Anchor point="TOPRIGHT" x="-10" y="-10"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="ResizeHandle" inherits="PanelResizeButtonTemplate" registerForDrag="LeftButton">
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </Button>
            <DropdownButton parentKey="ExpansionDropdown" inherits="WowStyle1DropdownTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Title" relativePoint="BOTTOMRIGHT" x="-150" y="-10" />
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Title" relativePoint="BOTTOMRIGHT" y="10"/>
                </Anchors>
            </DropdownButton>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>
</Ui>