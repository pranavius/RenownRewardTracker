<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="RRTListRewardTemplate" virtual="true" mixin="RRTListRewardMixin">
        <Size y="25"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg" hidden="true" setAllPoints="true">
                    <Color color="WHITE_FONT_COLOR" a="0.1"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="RewardType" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="70"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="260"/>
                        <Anchor point="BOTTOMLEFT" x="260"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="IconDescContainer">
                <Size x="250"/>
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMLEFT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="Icon" file="Interface/Icons/inv_misc_questionmark">
                            <Size x="25"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMLEFT"/>
                            </Anchors>
                        </Texture>
                        <FontString parentKey="Desc" inherits="GameFontHighlightSmall" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="5"/>
                                <Anchor point="BOTTOMLEFT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="5"/>
                                <Anchor point="TOPRIGHT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="CurrencyDisplay" inherits="InsecureActionButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="340"/>
                    <Anchor point="BOTTOMLEFT" x="340"/>
                    <Anchor point="RIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Frame>

    <Frame name="RRTListFactionHeaderTemplate" virtual="true" mixin="RRTListFactionHeaderMixin">
        <Size y="25"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg" atlas="UI-Frame-Bar-Fill-White" setAllPoints="true">
                    <Color color="WHITE_FONT_COLOR"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="FactionName" inherits="GameFontNormal" justifyH="CENTER" justifyV="MIDDLE" setAllPoints="true">
                    <Anchors>
                        <Anchor point="CENTER" y="-2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="QuartermasterPin" inherits="InsecureActionButtonTemplate" hidden="true">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" x="5" y="1"/>
                </Anchors>
                <NormalTexture atlas="Waypoint-MapPin-Untracked"/>
                <PushedTexture atlas="Waypoint-MapPin-Untracked">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
                    </Anchors>
                </PushedTexture>
            </Button>
            <Button parentKey="ToggleButton" inherits="InsecureActionButtonTemplate">
                <Size y="25"/>
                <Anchors>
                    <Anchor point="RIGHT" x="-5" y="-1"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="CENTER" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
